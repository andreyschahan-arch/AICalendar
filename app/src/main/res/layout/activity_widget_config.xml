<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:backgroundColor="#1E1E1E">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Настройка виджета"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <!-- Прозрачность -->
    <TextView
        android:id="@+id/txt_alpha_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Прозрачность фона: 80%"
        android:textColor="#DDDDDD"
        android:textSize="16sp" />

    <SeekBar
        android:id="@+id/seekbar_alpha"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="255"
        android:progress="204"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="24dp" />

    <!-- Выбор цвета -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Цвет фона:"
        android:textColor="#DDDDDD"
        android:textSize="16sp"
        android:layout_marginBottom="12dp" />

    <RadioGroup
        android:id="@+id/rg_colors"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RadioButton
            android:id="@+id/rb_dark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Тёмный (Классика)"
            android:textColor="#FFFFFF"
            android:checked="true" />

        <RadioButton
            android:id="@+id/rb_graphite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Графит"
            android:textColor="#FFFFFF" />

        <RadioButton
            android:id="@+id/rb_blue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Тёмно-синий"
            android:textColor="#FFFFFF" />

        <RadioButton
            android:id="@+id/rb_light"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Светлый"
            android:textColor="#FFFFFF" />
    </RadioGroup>

    <!-- Кнопка сохранить -->
    <Button
        android:id="@+id/btn_save_config"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Сохранить"
        android:layout_marginTop="32dp" />

</LinearLayout>

